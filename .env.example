# ==============================================================================
# BFFD — Environment Variables (VPS / Easypanel Configuration Example)
# ==============================================================================

DATABASE_URL=postgresql://postgres:sua_senha@seu_host:5432/postgres
NODE_ENV=production
APP_ENV=production
CONTROL_TOWER_BASE_URL=https://control-tower.seudominio.com
CONTROL_TOWER_PROJECT_ID=seu_project_id_uuid
CONTROL_TOWER_SCHEMA_NAME=saas_tower
SUPABASE_URL=https://supabase.seudominio.com
SUPABASE_SERVICE_ROLE_KEY=seu_supabase_service_role_key
SUPABASE_ANON_KEY=seu_supabase_anon_key
AUTHORITY_ADMIN_TOKEN=seu_admin_token_aqui
AUTHORITY_OPERATOR_TOKEN=seu_operator_token_aqui
AUTHORITY_REVIEWER_TOKEN=seu_reviewer_token_aqui
AUTHORITY_PUBLISHER_TOKEN=seu_publisher_token_aqui
AUTHORITY_VIEWER_TOKEN=seu_viewer_token_aqui
PORT=3000
HOST=0.0.0.0

# 2. Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_URL=https://tower.seudominio.com/api/webhook/telegram
TELEGRAM_SECRET_TOKEN=seu_token_secreto_webhook_telegram

# 3. Modelos de IA e Transcrição (LLM & Whisper)
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=whisper-1

# 4. Gateway & Segurança de Sessão
SESSION_JWT_SECRET=seu_jwt_secret_super_seguro_min_32_chars
MCP_SERVER_URL=http://mcp-server:3001
AGENT_RUNTIME_URL=http://agent-runtime:8000

# 5. Painel Web (Next.js)
NEXT_PUBLIC_APP_URL=https://control-tower.seudominio.com
NEXT_PUBLIC_SUPABASE_URL=https://supabase.seudominio.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu_supabase_anon_key

# 6. Faturamento (Stripe / Pix)
STRIPE_SECRET_KEY=sk_live_sua_chave_stripe
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret

N8N_API_KEY=seu_n8n_api_key
